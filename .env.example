# Copy to .env.local for local development. On Vercel, add these under Project → Settings → Environment Variables.

# --- Required ---------------------------------------------------------------
# MongoDB Atlas connection string (Database → Connect → Drivers).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Optional database name (defaults to the one in the URI, or "test").
MONGODB_DB=fleeket
# Random string, 32+ characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Canonical public URL — used for canonical links, sitemap and Open Graph. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.fleeket.com

# --- First administrator (only used while no owner/admin account exists) -----
ADMIN_EMAIL=
# 10+ characters. Change it after first sign-in by creating a new owner and removing this one, or keep it secret.
ADMIN_PASSWORD=

# --- Email notifications for new leads (optional) ---------------------------
# Any SMTP provider works (Microsoft 365 / Outlook, SendGrid, Postmark, Amazon SES…).
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Fleeket <fleeket@outlook.com>"

# --- Analytics (optional) ---------------------------------------------------
# GA4 Measurement ID. Loads only after a visitor accepts analytics cookies.
NEXT_PUBLIC_GA_ID=

# --- Maps (optional) ---------------------------------------------------------
# Raster tile URL for the provider maps. Defaults to OpenStreetMap's public tiles (light use only).
# For production traffic use a keyed provider, e.g. MapTiler:
#   https://api.maptiler.com/maps/dataviz/{z}/{x}/{y}.png?key=YOUR_KEY
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
